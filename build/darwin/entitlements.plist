<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened-runtime entitlements for a Go + WKWebView (Wails) app.
       allow-jit / unsigned-executable-memory are needed for the WebKit
       JavaScript JIT; without them the webview crashes under hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Required to reach Location Services under the hardened runtime. The
       NSLocation* usage strings in Info.plist are necessary but not sufficient:
       without this entitlement macOS blocks CoreLocation, so the Wi-Fi
       analyzer can never get the grant that reveals neighbor SSIDs. -->
  <key>com.apple.security.personal-information.location</key>
  <true/>
  <!-- Required to use the Bluetooth radio under the hardened runtime. As with
       location, the NSBluetoothAlwaysUsageDescription string in Info.plist is
       necessary but not sufficient: without this entitlement macOS blocks
       CoreBluetooth, so the BLE nearby-survey can never scan. -->
  <key>com.apple.security.device.bluetooth</key>
  <true/>
</dict>
</plist>
